# ---------------------------------------------------------------------------
# 原典PDF・生成物はコミットしない（SPEC §1.1 / §7.2）
#   第三者著作物の再配布を避けるため、およびGit履歴にバイナリを残さないため
#   .gitignore は行末コメントを解釈しないので、説明は必ず行単位で書くこと
# ---------------------------------------------------------------------------

# 原典PDF置き場。manifest.yaml の URL と SHA256 から再取得できる
source/

# pdftotext の抽出テキストなど中間ファイル
work/

# pdftoppm + cwebp の生成画像
images/

# ビルド成果物。Pages へはアーティファクトとして直接配信する
dist/

# ---------------------------------------------------------------------------
# 一般
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
*.log
.cache/
