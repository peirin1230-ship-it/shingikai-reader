# ---------------------------------------------------------------------------
# 原典PDF・生成物はコミットしない（SPEC §1.1 / §7.2）
#   第三者著作物の再配布を避けるため、およびGit履歴にバイナリを残さないため
#   .gitignore は行末コメントを解釈しないので、説明は必ず行単位で書くこと
# ---------------------------------------------------------------------------

# 原典PDF置き場。manifest.yaml の URL と SHA256 から再取得できる
source/

# pdftotext / tesseract の抽出テキストは追跡する（原典から再生成できるが、
# 訂正版に差し替えられたときの差分を見るために履歴に残す価値がある）。
# 画像などテキスト以外の中間ファイルは無視する
/work/**
!/work/**/
!/work/**/*.txt
!/work/**/*.json

# 全体版（zentai）は議事次第・委員名簿・資料1・資料2・参考資料をそのまま
# 連結したPDF。抽出テキストが個別資料とページ単位でバイト一致することを
# 確認済みなので、重複をコミットしない。抽出自体は行われる
/work/*/*/zentai/

# pdftoppm + cwebp の生成画像
images/

# ビルド成果物。Pages へはアーティファクトとして直接配信する
dist/

# ---------------------------------------------------------------------------
# 一般
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
Thumbs.db
*.log
.cache/
